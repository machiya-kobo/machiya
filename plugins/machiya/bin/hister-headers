#!/bin/sh
# The headers for Hister's MCP (the plugin's `headersHelper`): the owner's Hister token as X-Access-Token, so the token is
# fetched when Claude Code connects (and again after a 401/403) instead of being written into any settings file.
# Where it comes from, first found: $HISTER_TOKEN_FILE (a file holding the token); then, with `hpass` (pass with this
# machine's host key: never the owner's YubiKey, so nothing prompts), $HISTER_TOKEN_PASS, else this machine's own copy
# hosts/<host>/hister-owner-token, else hosts/server/stacks/hister/owner-token.
# Nothing found prints {}: no header (a Hister without users needs none). Never prints anything but the JSON.
tok=""
if [ -n "${HISTER_TOKEN_FILE:-}" ] && [ -r "$HISTER_TOKEN_FILE" ]; then
    tok=$(head -n 1 "$HISTER_TOKEN_FILE" 2>/dev/null)
elif command -v hpass >/dev/null 2>&1; then
    host=$(hostname -s 2>/dev/null | tr 'A-Z' 'a-z')
    for p in ${HISTER_TOKEN_PASS:-} "hosts/$host/hister-owner-token" hosts/server/stacks/hister/owner-token; do
        tok=$(hpass show "$p" 2>/dev/null | head -n 1)
        [ -n "$tok" ] && break
    done
fi
tok=$(printf '%s' "$tok" | tr -d '\r\n\t ')
case "$tok" in
    ""|*[!A-Za-z0-9._~+/=-]*) printf '{}\n' ;;                      # none, or not a token: send no header
    *) printf '{"X-Access-Token": "%s"}\n' "$tok" ;;
esac
