#!/bin/ksh
#
# Konbini, the project board, part of Machiya (docs/install/bsd.md). OpenBSD: rc.d(8) + rc.subr(8); output to syslog
# (daemon.info, /var/log/daemon). There's no supervisor: see the restart cron in the doc.
#
#   rcctl enable konbini && rcctl start konbini
#
# rc.d can't give a daemon environment variables, so the settings live in /etc/konbini.env (KEY=VALUE lines) and the
# app reads them itself (--env-file, or KANBAN_ENV_FILE). Change the flags with `rcctl set konbini flags ...`.
# The user _konbini has HOME=/var/db/konbini (useradd -d), which is also its data directory.

# The venv of docs/install/bsd.md §2 (markdown 3.11; OpenBSD's pip refuses the system Python, PEP 668) when it
# exists, else the system python3. rcctl can't change `daemon`: edit these lines for another interpreter.
daemon="/usr/local/bin/python3"
[ -x /usr/local/lib/machiya-venv/bin/python3 ] && daemon="/usr/local/lib/machiya-venv/bin/python3"
daemon_flags="-u /usr/local/share/konbini/app.py --env-file /etc/konbini.env"
daemon_user="_konbini"
daemon_logger="daemon.info"
daemon_execdir="/var/db/konbini"

. /etc/rc.d/rc.subr

rc_bg=YES
rc_reload=NO

rc_pre() {
    [ -r /etc/konbini.env ] || { echo "/etc/konbini.env is missing (see docs/install/bsd.md)"; return 1; }
}

rc_cmd $1
