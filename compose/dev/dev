def detect_engine():
    if shutil.which("podman"):
        return "podman"
    if shutil.which("docker") and subprocess.run(["docker", "info"], capture_output=True).returncode == 0:
        return "docker"
    die("neither podman nor docker found: use --native")


def podman_socket(data):
    """`podman compose` drives docker-compose through an API socket: DOCKER_HOST, the user's podman.socket, or one
    started here (left running in the background, like the stack)."""
    if os.environ.get("DOCKER_HOST"):
        return os.environ["DOCKER_HOST"]
    run_dir = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    user_sock = os.path.join(run_dir, "podman", "podman.sock")
    for sock in (user_sock, os.path.join(data, "podman.sock")):
        if os.path.exists(sock):
            try:
                with socket.socket(socket.AF_UNIX) as s:
                    s.connect(sock)
                return "unix://" + sock
            except OSError:
                pass
    sock = os.path.join(data, "podman.sock")
    if os.path.exists(sock):
        os.unlink(sock)
    subprocess.Popen(["podman", "system", "service", "--time=0", "unix://" + sock], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(50):
        if os.path.exists(sock):
            break
        time.sleep(0.1)
    return "unix://" + sock


def compose_cmd(env, data, *args):
    return [env["DEV_ENGINE"], "compose", "--project-name", project(env), "--env-file", os.path.join(data, "dev.env"),
            "-f", os.path.join(HERE, "compose.yml")] + list(args)


def compose_env(env, data):
    e = dict(os.environ)
    if env["DEV_ENGINE"] == "podman":
        e["DOCKER_HOST"] = podman_socket(data)
        e.setdefault("PODMAN_COMPOSE_WARNING_LOGS", "false")
    return e


def compose(env, data, *args, check=True, capture=False):
    engine = env["DEV_ENGINE"]
    r = subprocess.run(compose_cmd(env, data, *args), cwd=HERE, env=compose_env(env, data), capture_output=capture,
                       text=True)
    if check and r.returncode != 0:
        die("%s compose %s failed (exit %d)%s" % (engine, " ".join(args), r.returncode,
                                                   ("\n" + r.stderr[-3000:]) if capture else ""))
    return r


