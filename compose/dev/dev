def project(env):
    """The compose project: machiya-dev, or the --project a second stack on this machine was made with."""
    return env.get("DEV_PROJECT") or PROJECT


def local_addr(env):
    """This machine's address of the published ports: DEV_BIND (127.0.0.1 unless --bind; a second stack beside a
    standing one binds another loopback address, 127.0.0.2), or 127.0.0.1 for a wildcard bind."""
    bind = (env.get("DEV_BIND") or "127.0.0.1").strip()
    return "127.0.0.1" if bind in ("0.0.0.0", "::", "") else bind


