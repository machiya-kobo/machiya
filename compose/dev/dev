def git(*args, cwd=None, env=None):
    e = dict(os.environ, GIT_CONFIG_NOSYSTEM="1", GIT_AUTHOR_NAME="Machiya Dev Seed",
             GIT_AUTHOR_EMAIL="dev-seed@example.invalid", GIT_COMMITTER_NAME="Machiya Dev Seed",
             GIT_COMMITTER_EMAIL="dev-seed@example.invalid", GIT_AUTHOR_DATE=SEED_DATE,
             GIT_COMMITTER_DATE=SEED_DATE, **(env or {}))
    e.pop("GIT_DIR", None)
    return subprocess.run(["git", "-c", "commit.gpgsign=false", "-c", "init.defaultBranch=main"] + list(args),
                          cwd=cwd, env=e, check=True, capture_output=True, text=True).stdout.strip()


def make_certs(data, host):
    """A throwaway CA and a leaf certificate (825 days) for localhost, 127.0.0.1 and the dev host."""
    certs = os.path.join(data, "certs")
    os.makedirs(certs, exist_ok=True)
    if os.path.exists(os.path.join(certs, "tls.crt")):
        return
    env = dict(os.environ)
    if not any(os.path.exists(p) for p in ("/etc/ssl/openssl.cnf", "/etc/openssl/openssl.cnf",
                                             "/usr/local/etc/ssl/openssl.cnf", "/usr/lib/ssl/openssl.cnf")):
        env.setdefault("OPENSSL_CONF", "/dev/null")      # a clean NetBSD 11 has no openssl.cnf: `req` exits 1 without one
    def ossl(*args):
        subprocess.run(["openssl"] + list(args), cwd=certs, check=True, capture_output=True, env=env)
    ossl("req", "-x509", "-newkey", "rsa:2048", "-nodes", "-keyout", "ca.key", "-out", "ca.crt", "-days", "825",
         "-subj", "/CN=Machiya dev stack throwaway CA")
    ossl("req", "-newkey", "rsa:2048", "-nodes", "-keyout", "tls.key", "-out", "tls.csr", "-subj", "/CN=" + host)
    names = ["DNS:localhost", "IP:127.0.0.1"] + ([("IP:" if re.fullmatch(r"[0-9.]+", host) else "DNS:") + host]
                                                if host not in ("localhost", "127.0.0.1") else [])
    with open(os.path.join(certs, "ext.cnf"), "w") as f:
        f.write("subjectAltName=%s\nextendedKeyUsage=serverAuth\nbasicConstraints=CA:FALSE\n" % ",".join(names))
    ossl("x509", "-req", "-in", "tls.csr", "-CA", "ca.crt", "-CAkey", "ca.key", "-CAcreateserial", "-out", "tls.crt",
         "-days", "825", "-extfile", "ext.cnf")
    for f in ("ca.key", "tls.key"):
        os.chmod(os.path.join(certs, f), 0o600)


def make_vault(data):
    """sample-vault/ + seed/vault/ (work: private, team: shared) as one commit with a fixed date, then a bare
    repository (the services' VAULT_REPO_URL) and the board's clone."""
    bare, work = os.path.join(data, "vault.git"), os.path.join(data, "vault-src")
    if os.path.exists(bare):
        return git("rev-parse", "HEAD", cwd=bare)
    shutil.rmtree(work, ignore_errors=True)
    shutil.copytree(os.path.join(MACHIYA, "sample-vault"), work)
    os.unlink(os.path.join(work, "README.md"))
    seed = os.path.join(HERE, "seed", "vault")
    for top in sorted(os.listdir(seed)):
        if top != "README.md":
            shutil.copytree(os.path.join(seed, top), os.path.join(work, top))
    git("init", "-q", cwd=work)
    git("add", "-A", cwd=work)
    git("commit", "-q", "-m", "dev seed: the sample vault, a private work vault and a shared team vault", cwd=work)
    head = git("rev-parse", "HEAD", cwd=work)
    git("clone", "-q", "--bare", work, bare)
    shutil.rmtree(work)
    git("clone", "-q", bare, os.path.join(data, "konbini-repo"))
    return head


def hister_cmd(env, data, *args, tty=False):
    """The hister CLI on the dev Hister's data (Hister itself stopped or not started yet)."""
    conf = os.path.join(HERE, "config", "hister.yml")
    if env["DEV_ENGINE"] == "native":
        e = dict(HISTER_CONFIG=conf, HISTER_DATA_DIR=os.path.join(data, "hister"), HISTER__APP__USER_HANDLING="true",
                 # the CLI loads the server config too, and refuses 0.0.0.0 without a base URL (found on tv-freebsd)
                 HISTER__SERVER__BASE_URL=env.get("DEV_URL", "http://127.0.0.1") + ":19204",
                 **read_env(os.path.join(data, "secrets", "hister.env")))
        return [env.get("HISTER_BIN") or "hister"] + list(args), e
    cmd = [env["DEV_ENGINE"], "run", "--rm"] + (["-it"] if tty else []) + [
        "--env-file", os.path.join(data, "secrets", "hister.env"),
        "-e", "HISTER_CONFIG=/hister/config.yml", "-e", "HISTER__APP__USER_HANDLING=true",
        "-v", "%s:/hister/data" % os.path.join(data, "hister"), "-v", "%s:/hister/config.yml:ro" % conf,
        "--user", "%s:%s" % (env["DEV_UID"], env["DEV_GID"])]
    if env.get("DEV_USERNS"):
        cmd += ["--userns", env["DEV_USERNS"]]
    return cmd + [HISTER_IMAGE] + list(args), {}


def make_owner(env, data):
    """The dummy owner: `hister create-user` (it insists on a TTY: tty_create_user.py types the password from its file),
    its token to secrets/owner-token, and the stub OIDC login bound to it (as tsidp's is bound in production)."""
    tok = os.path.join(data, "secrets", "owner-token")
    if os.path.exists(tok) and os.path.getsize(tok):
        return
    cmd, extra = hister_cmd(env, data, "create-user", OWNER, "--admin", tty=True)
    r = subprocess.run([sys.executable, os.path.join(MACHIYA, "stack", "hister-login", "dev", "tty_create_user.py"),
                        os.path.join(data, "secrets", "owner-password")] + cmd,
                       env=dict(os.environ, **extra), capture_output=True, text=True)
    if r.returncode != 0 or "User created" not in r.stdout:
        die("hister create-user failed: %s %s" % (r.stdout.strip()[-500:], r.stderr.strip()[-500:]))
    cmd, extra = hister_cmd(env, data, "show-user", OWNER, "--token")
    r = subprocess.run(cmd, env=dict(os.environ, **extra), capture_output=True, text=True)
    plain = re.sub(r"\x1b\[[0-9;]*m", "", r.stdout)
    m = re.search(r"^\s*Token\s*:\s*(\S+)", plain, re.M)
    if not m:
        die("hister show-user gave no token (exit %d)" % r.returncode)
    fd = os.open(tok, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(m.group(1) + "\n")
    db = sqlite3.connect(os.path.join(data, "hister", "db.sqlite3"))
    db.execute("UPDATE users SET o_auth_id = ? WHERE username = ?", (OIDC_ID, OWNER))
    db.commit()
    db.close()
    say("Hister owner '%s' made (password and token in %s, not shown); OIDC login bound" % (OWNER, os.path.dirname(tok)))


def cmd_init(a):
    data = data_dir(a.data)
    if os.path.exists(os.path.join(data, "dev.env")):
        die("%s already holds a dev stack: ./dev reset to start over, or ./dev up" % data)
    siblings = os.path.abspath(a.siblings or os.environ.get("MACHIYA_DEV_SIBLINGS") or os.path.dirname(MACHIYA))
    for repo in ("kura", "niwa", "konbini"):
        if not os.path.isdir(os.path.join(siblings, repo, "app")):
            die("%s/%s/app not found: clone %s next to machiya (or --siblings DIR)" % (siblings, repo, repo))
    url = (a.url or "https://localhost").rstrip("/")
    u = urllib.parse.urlsplit(url)
    if u.scheme not in ("http", "https") or not u.hostname or u.port or (u.path not in ("", "/")):
        die("--url is a scheme and a host only (each service adds its port): http://localhost, "
            "https://claude.example.ts.net")
    engine = "native" if a.native else (a.engine or detect_engine())
    a.project = getattr(a, "project", None) or PROJECT
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,40}", a.project):
        die("--project is a compose project name: lowercase letters, digits, _ and -")
    a.signin_provider = (getattr(a, "signin_provider", "oidc") or "").strip().lower()
    if a.signin_provider not in ("", "oidc"):
        die("--signin-provider is oidc (the stub OIDC provider, as tsidp in production) or empty (the helper's page)")
    remote = getattr(a, "remote_hister", None)
    if remote and engine != "native":
        die("--remote-hister is for --native (a host that can't run Hister, such as Haiku)")
    os.makedirs(data, exist_ok=True)
    if remote:      # the other stack's dummy owner and OIDC secret, so its Hister (through a tunnel) knows us
        os.makedirs(os.path.join(data, "secrets"), mode=0o700, exist_ok=True)
        for name in ("owner-password", "owner-token", "oidc-client-secret", "hister.env"):
            src, dst = os.path.join(remote, name), os.path.join(data, "secrets", name)
            if not os.path.isfile(src):
                die("--remote-hister %s has no %s (copy the Hister host's $DEV_DATA/secrets)" % (remote, name))
            shutil.copyfile(src, dst)
            os.chmod(dst, 0o600)
    for d in DATA_DIRS:
        os.makedirs(os.path.join(data, d), exist_ok=True)
    make_secrets(data)
    head = make_vault(data)
    tls = u.scheme == "https" and not a.behind_serve
    if tls:
        make_certs(data, u.hostname)
    else:
        os.makedirs(os.path.join(data, "certs"), exist_ok=True)
    userns = ""
    if engine == "podman":
        userns = "keep-id"
    env = {
        "DEV_ENGINE": engine, "DEV_URL": url, "DEV_HOST": u.hostname, "DEV_BIND": a.bind,
        "DEV_DATA": data, "DEV_ROOT": HERE, "MACHIYA_SRC": MACHIYA,
        "KURA_SRC": os.path.join(siblings, "kura"), "NIWA_SRC": os.path.join(siblings, "niwa"),
        "KONBINI_SRC": os.path.join(siblings, "konbini"),
        "DEV_UID": str(os.getuid()), "DEV_GID": str(os.getgid()), "DEV_USERNS": userns,
        "DEV_COOKIE_DOMAIN": a.cookie_domain or "", "DEV_TAILNET_USERS": a.tailnet_users or "owner@dev",
        "DEV_SSO_COOKIE": a.sso_cookie or "", "DEV_REMOTE_HISTER": os.path.abspath(remote) if remote else "",
        "DEV_PROJECT": a.project or PROJECT, "DEV_SIGNIN_PROVIDER": a.signin_provider,
        "DEV_FRONT_SCHEME": "https" if tls else "http",
        "DEV_TLS_CERT": "/certs/tls.crt" if tls else "", "DEV_TLS_KEY": "/certs/tls.key" if tls else "",
    }
    if engine == "native" and os.environ.get("HISTER_BIN"):
        env["HISTER_BIN"] = os.path.abspath(os.environ["HISTER_BIN"])
    pointer = os.path.join(HERE, ".data-dir")
    if data != os.path.join(HERE, "data") and not os.path.exists(pointer):    # the first stack made here is the default
        with open(pointer, "w") as f:
            f.write(data + "\n")
    if engine != "native":
        subprocess.run([engine, "pull", "-q", HISTER_IMAGE], capture_output=True)
    elif not remote and not shutil.which(env.get("HISTER_BIN") or "hister"):
        die("--native needs the hister binary: HISTER_BIN=/path/to/hister or `hister` on PATH, or --remote-hister "
            "(docs/dev-stack.md)")
    if not remote:
        make_owner(env, data)
    with open(os.path.join(data, "dev.env"), "w") as f:            # last: its presence means "initialised"
        f.write("# Written by compose/dev/dev init. The dev stack's settings (no secrets here; those are in secrets/).\n")
        for k, v in env.items():
            f.write("%s=%s\n" % (k, v))
    say("ready: %s (engine %s, vault commit %s, public base %s)" % (data, engine, head[:12], url))
    say("next: ./dev up")


