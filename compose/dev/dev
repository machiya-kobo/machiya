VAR_RE = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)(?:(:?[-?])([^}]*))?\}")


def interpolate(value, env):
    def sub(m):
        name, op, arg = m.group(1), m.group(2), m.group(3)
        v = env.get(name)
        if op == ":-":
            return v if v else arg
        if op == "-":
            return v if v is not None else arg
        if op in (":?", "?"):
            if not v:
                die("%s is required: %s" % (name, arg))
        return v or ""
    return VAR_RE.sub(sub, str(value))


def native_plan(env):
    import yaml                                   # the rooms need pyyaml anyway
    with open(os.path.join(HERE, "compose.yml")) as f:
        spec = yaml.safe_load(f)
    hosts = spec["x-native"]["hosts"]
    plan = []
    for name, svc in spec["services"].items():
        nat = svc.get("x-native") or {}
        if nat.get("skip"):
            plan.append((name, None, None, None, nat["skip"]))
            continue
        raw = svc.get("environment") or {}
        if isinstance(raw, list):
            raw = dict(x.split("=", 1) for x in raw)
        out = {}
        for k, v in raw.items():
            v = interpolate("" if v is None else v, env)
            for src, dst in hosts.items():
                v = v.replace("//" + src, "//" + dst)
            for src, dst in (nat.get("paths") or {}).items():      # /data, /data/x, name=/vault#sub, a,/b
                v = re.sub(r"(^|[=,])" + re.escape(src) + r"(?=$|[/#,])",
                           lambda m: m.group(1) + interpolate(dst, env), v)
            out[k] = v
        if nat.get("env_file"):
            out.update(read_env(interpolate(nat["env_file"], env)))
        for k, v in (nat.get("env") or {}).items():
            out[k] = interpolate(v, env)
        cmd = [interpolate(c, env) for c in nat["cmd"]]
        cwd = interpolate(nat.get("cwd") or env["DEV_DATA"], env)
        plan.append((name, cmd, cwd, out, None))
    return plan


def native_up(env, data):
    run = os.path.join(data, "run")
    os.makedirs(run, exist_ok=True)
    order = ["stub-idp", "hister", "hister-login", "front", "fixtures", "fake-newsblur", "vault-mirror", "kura",
             "niwa", "konbini", "landing", "smallweb", "machiya-mcp", "feed-import", "fake-forgejo", "fake-github",
             "code-import"]
    plan = {p[0]: p for p in native_plan(env)}
    for name in order + [n for n in plan if n not in order]:
        _, cmd, cwd, extra, skip = plan[name]
        if skip:
            say("%s: skipped natively (%s)" % (name, skip))
            continue
        pidf = os.path.join(run, name + ".pid")
        if os.path.exists(pidf):
            try:
                os.kill(int(open(pidf).read()), 0)
                continue                                   # already running
            except (OSError, ValueError):
                pass
        if name == "hister" and env.get("DEV_REMOTE_HISTER"):
            say("hister: remote (127.0.0.1:19224 is a tunnel to the Hister host's stack)")
            continue
        if name == "hister" and not shutil.which(cmd[0]):
            say("hister: no binary (%s): skipped; the rooms answer 503 until a Hister runs on 127.0.0.1:19224" % cmd[0])
            continue
        log = open(os.path.join(data, "logs", name + ".log"), "ab")
        e = dict(os.environ, PYTHONUNBUFFERED="1", PYTHONDONTWRITEBYTECODE="1", **extra)
        p = subprocess.Popen(cmd, cwd=cwd, env=e, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                             start_new_session=True)
        with open(pidf, "w") as f:
            f.write(str(p.pid))
        say("%s: started (pid %d, log logs/%s.log)" % (name, p.pid, name))
        if name == "vault-mirror":
            wait_for(lambda: os.path.exists(os.path.join(data, "mirror", "vault", ".git")), 120, "the vault mirror")
        time.sleep(0.3)


def native_down(data):
    run = os.path.join(data, "run")
    for f in sorted(os.listdir(run)) if os.path.isdir(run) else []:
        if f.endswith(".pid"):
            try:
                pid = int(open(os.path.join(run, f)).read())
                os.killpg(pid, signal.SIGTERM)
                say("%s: stopped" % f[:-4])
            except (OSError, ValueError):
                pass
            os.unlink(os.path.join(run, f))


