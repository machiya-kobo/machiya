def wait_for(fn, seconds, what):
    end = time.time() + seconds
    while time.time() < end:
        try:
            if fn():
                return True
        except Exception:
            pass
        time.sleep(2)
    die("timed out waiting for %s" % what)


def http(method, url, data=None, headers=None, form=False, timeout=15):
    body = None
    h = dict(headers or {})
    if data is not None:
        body = (urllib.parse.urlencode(data) if form else json.dumps(data)).encode()
        h["Content-Type"] = "application/x-www-form-urlencoded" if form else "application/json"
    req = urllib.request.Request(url, body, h, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=UNVERIFIED) as r:
            raw = r.read()
            status = r.status
    except urllib.error.HTTPError as e:
        raw, status = e.read(), e.code
    try:
        return status, json.loads(raw) if raw.strip() else None
    except ValueError:
        return status, raw.decode("utf-8", "replace")


SCHEME = {"front": "https"}


def local(port, path=""):
    """This machine's own address of a port: the front's ports in its scheme, the rest plain http."""
    return "%s://%s:%d%s" % (SCHEME["front"] if port in FRONT_PORTS else "http", ADDR[0], port, path)


def ready(port, path, want=None, headers=None):
    st, body = http("GET", local(port, path), headers=headers, timeout=5)
    return st == 200 and (want is None or (isinstance(body, dict) and want(body)))


def cmd_up(a):
    data = data_dir(a.data)
    env = load(data)
    upgrade(data, env)
    if env["DEV_ENGINE"] == "native":
        native_up(env, data)
    else:
        say("building the images (log: %s)" % os.path.join(data, "logs", "build.log"))
        with open(os.path.join(data, "logs", "build.log"), "w") as log:
            r = subprocess.run(compose_cmd(env, data, "build"), cwd=HERE, env=compose_env(env, data), stdout=log,
                               stderr=subprocess.STDOUT)
        if r.returncode:
            die("the build failed: see %s" % os.path.join(data, "logs", "build.log"))
        compose(env, data, "up", "-d", "vault-mirror")
        wait_for(lambda: os.path.exists(os.path.join(data, "mirror", "vault", ".git")), 120, "the vault mirror")
        for attempt in range(3):
            r = compose(env, data, "up", "-d", check=attempt == 2)
            if r.returncode == 0:
                break
            # rootless podman sometimes gives a keep-id container a broken uid map when many are created at once
            # ("no mapping found for uid 0"); the containers that never started are made again
            ids = subprocess.run(["podman" if env["DEV_ENGINE"] == "podman" else "docker", "ps", "-aq", "--filter",
                                  "label=com.docker.compose.project=" + project(env), "--filter", "status=created"],
                                 capture_output=True, text=True).stdout.split()
            say("compose up failed; recreating %d container(s) that never started, again" % len(ids))
            if ids:
                subprocess.run([env["DEV_ENGINE"], "rm", "-f"] + ids, capture_output=True)
    say("waiting for the services")
    wait_for(lambda: ready(19224, "/health"), 120, "Hister (19224/health)")
    wait_for(lambda: ready(19204, "/health"), 60, "the front (19204)")
    wait_for(lambda: ready(19204, "/machiya/healthz", lambda b: b.get("hister") == "ok"), 60, "the helper")
    wait_for(lambda: ready(19201, "/api/status", lambda b: b.get("ready")), 180, "Kura")
    wait_for(lambda: ready(19202, "/api/status", lambda b: b.get("ready")), 180, "Niwa")
    wait_for(lambda: ready(19203, "/healthz"), 180, "Konbini")
    wait_for(lambda: ready(19200, "/healthz"), 60, "landing")
    seed(env, data, quiet=True)
    skip = {"shiori"} | ({"searxng"} if env["DEV_ENGINE"] == "native" else set())       # a client; optional natively
    owner = {"Authorization": "Bearer " + secret(data, "owner-token")}      # landing signs in like the rooms
    wait_for(lambda: ready(19200, "/api/status", lambda b: all(
        (v or {}).get("state") == "up" for k, v in b.get("apps", {}).items() if k not in skip), owner), 120,
        "landing to see every app up")
    status(env, data)


def html_text(path):
    with open(path, encoding="utf-8") as f:
        page = f.read()
    title = re.search(r"<title>(.*?)</title>", page, re.S).group(1).strip()
    body = re.search(r"<body>(.*)</body>", page, re.S).group(1)
    text = re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", body)).strip()
    return title, text, body.strip()


def seed(env, data, quiet=False):
    """The synthetic Hister corpus (seed/hister.json), through Hister's API with the dummy owner's token. Idempotent:
    a page is re-added only when Hister doesn't have it, aliases are set, history entries added once."""
    with open(os.path.join(HERE, "seed", "hister.json")) as f:
        spec = json.load(f)
    h = {"Origin": "hister://", "Accept": "application/json", "X-Access-Token": secret(data, "owner-token")}
    base = local(19224)                                  # Hister itself, plain
    added = 0
    for p in spec["pages"]:
        st, _ = http("GET", base + "/api/document?" + urllib.parse.urlencode({"url": p["url"]}), headers=h)
        if st == 200:
            continue
        title, text, body = html_text(os.path.join(HERE, "seed", "site", p["file"]))
        doc = {"url": p["url"], "title": title, "text": text, "html": body, "label": p["label"],
               "added": calendar.timegm(time.strptime(p["added"], "%Y-%m-%dT%H:%M:%SZ")),
               "metadata": {"source": "dev-seed"}}
        st, out = http("POST", base + "/api/add", doc, headers=h)
        if st not in (200, 201):
            die("Hister refused %s: HTTP %d %s" % (p["url"], st, str(out)[:200]))
        added += 1
    st, rules = http("GET", base + "/api/rules", headers=h)
    have = (rules or {}).get("aliases") or {} if isinstance(rules, dict) else {}
    for k, v in spec["aliases"].items():
        if have.get(k) != v:
            st, _ = http("POST", base + "/api/add_alias", {"alias-keyword": k, "alias-value": v}, headers=h, form=True)
            if st != 200:
                die("Hister refused the alias @%s: HTTP %d" % (k, st))
    st, hist = http("GET", base + "/api/history?opened=true", headers=h)
    items = (hist or {}).get("documents") or [] if isinstance(hist, dict) else []
    seen = {(i.get("url"), i.get("query")) for i in items if isinstance(i, dict)}
    for entry in spec["history"]:
        if (entry["url"], entry["query"]) not in seen:
            st, _ = http("POST", base + "/api/history", entry, headers=h)
            if st != 200:
                die("Hister refused a history entry: HTTP %d" % st)
    with open(os.path.join(data, "seeded.json"), "w") as f:
        json.dump({"pages": len(spec["pages"]), "aliases": sorted(spec["aliases"]), "history": len(spec["history"]),
                   "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}, f)
    say("seeded Hister: %d page(s) added (%d in the seed), %d alias(es), %d history entr(ies)" % (
        added, len(spec["pages"]), len(spec["aliases"]), len(spec["history"])))


