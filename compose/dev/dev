def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--data", help="the dev stack's data folder (default: MACHIYA_DEV_DATA, .data-dir, ./data)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("init")
    p.add_argument("--url", help="the public base, scheme and host only (default https://localhost)")
    p.add_argument("--behind-serve", action="store_true",
                   help="a real Tailscale Serve terminates TLS for --url: the front speaks plain http")
    p.add_argument("--bind", default="127.0.0.1", help="the address the ports are published on (default 127.0.0.1)")
    p.add_argument("--native", action="store_true", help="no containers: run every service as a process")
    p.add_argument("--engine", choices=["podman", "docker"], help="default: podman if installed, else docker")
    p.add_argument("--siblings", help="where the kura, niwa and konbini checkouts are (default: next to machiya)")
    p.add_argument("--tailnet-users", help="Niwa's and Konbini's fallback login(s) (default owner@dev)")
    p.add_argument("--cookie-domain", help="MACHIYA_COOKIE_DOMAIN (default: none, host-only cookies)")
    p.add_argument("--remote-hister", metavar="SECRETS_DIR",
                   help="--native without a local Hister: use the Hister on 127.0.0.1:19224 (an ssh tunnel to another "
                        "dev stack) with that stack's secrets, copied to SECRETS_DIR")
    p.add_argument("--sso-cookie", help="MACHIYA_SSO_COOKIE, the sign-in cookie's name (default machiya_sso; "
                                        "machiya_dev_sso where a production stack shares the cookie domain)")
    p.add_argument("--project", help="the compose project (default machiya-dev): a second stack on this machine, "
                                     "with its own --bind (127.0.0.2) and --url (https://127.0.0.2)")
    p.add_argument("--signin-provider", default="oidc",
                   help="MACHIYA_SIGNIN_PROVIDER for the rooms and landing: oidc (the default, as production: a page "
                        "signs itself in through the stub OIDC provider) or '' (the helper's page)")
    p.set_defaults(fn=cmd_init)
    p = sub.add_parser("up")
    p.add_argument("--verbose", action="store_true")
    p.set_defaults(fn=cmd_up)
    sub.add_parser("seed").set_defaults(fn=cmd_seed)
    p = sub.add_parser("check")
    p.add_argument("--browser", action="store_true", help="also the Playwright checks (Chromium and WebKit)")
    p.add_argument("--shots", help="screenshots folder (default $DEV_DATA/shots)")
    p.add_argument("--python", help="a Python with Playwright for --browser (default: this one)")
    p.set_defaults(fn=cmd_check)
    sub.add_parser("status").set_defaults(fn=cmd_status)
    p = sub.add_parser("logs")
    p.add_argument("service")
    p.set_defaults(fn=cmd_logs)
    sub.add_parser("down").set_defaults(fn=cmd_down)
    p = sub.add_parser("reset")
    p.add_argument("--yes", action="store_true")
    p.set_defaults(fn=cmd_reset)
    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
