def make_secrets(data):
    sec = os.path.join(data, "secrets")
    os.makedirs(sec, exist_ok=True)
    os.chmod(sec, 0o700)

    def put(name, value, mode=0o600):
        path = os.path.join(sec, name)
        if not os.path.exists(path):
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
            with os.fdopen(fd, "w") as f:
                f.write(value + "\n")
        os.chmod(path, mode)

    put("owner-password", secrets.token_urlsafe(18))
    put("oidc-client-secret", secrets.token_urlsafe(24))
    put("hister.env", "HISTER__SERVER__OAUTH__OIDC__CLIENT_SECRET=" + secret(data, "oidc-client-secret"))
    put("searxng.env", "SEARXNG_SECRET=" + secrets.token_hex(32))
    put("newsblur-token", "devnb_" + secrets.token_urlsafe(24))
    put("forgejo-token", "devfj_" + secrets.token_urlsafe(24))           # code-import's fake forges
    put("github-lantern-token", "devgh_" + secrets.token_urlsafe(24))
    put("github-workshop-token", "devgh_" + secrets.token_urlsafe(24))


