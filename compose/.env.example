# Machiya reference compose settings: copy to .env and edit. (`./demo-init` writes one for the sample vault.)
# Unset URLs switch the features that need them off. Paths that get mounted into containers must be absolute.

# Which services run (profiles): engines (hister, searxng), kura, niwa, konbini.
COMPOSE_PROFILES=engines,kura,niwa,konbini
# One shared copy of the vault for the whole stack (also set MIRROR_DATA to an absolute path):
#COMPOSE_FILE=compose.yml:mirror.yml
#MIRROR_DATA=/srv/machiya/mirror

# The containers run as these ids, so the folders they write stay yours: `id -u` and `id -g`. Rootless podman also needs
# MACHIYA_USERNS=keep-id and MACHIYA_NO_HEALTHCHECK=true (its healthchecks can't run there); leave both unset for Docker.
MACHIYA_UID=1000
MACHIYA_GID=1000
MACHIYA_USERNS=
#MACHIYA_NO_HEALTHCHECK=true

# The vault: a git repository the apps clone (an https, ssh or file:// URL), the folder in it that holds the notes, and
# (https) a user and a token file. Niwa also writes to it: it needs write access (an ssh deploy key or a file:// path).
VAULT_REPO_URL=https://git.example/user/vault.git
#VAULT_SUBDIR=personal          # unset: the notes are at the repository's root
#VAULT_REPO_USER=vault-reader
#VAULT_TOKEN_FILE=/path/to/vault-token
# A file:// vault: the repository's folder, mounted into the containers at the same path.
#VAULT_GIT=/srv/machiya/vault.git
# Konbini's own read-write clone of the vault (clone it there first; its origin is the vault repository).
KONBINI_REPO=/srv/machiya/konbini-repo

# Who may use each app: `open` (no check; fine only because the ports bind 127.0.0.1) or `tailscale` (the
# Tailscale-User-Login header a proxy in front sets, and the logins allowed below; `*` = anyone who reaches the port).
KURA_AUTH=open
NIWA_AUTH=open
KONBINI_AUTH=open
#KURA_USERS=you@example.com
#NIWA_USERS=you@example.com
#KONBINI_USERS=you@example.com
# In tailscale mode: the address tailscale serve's connections reach the apps from (docs/install/remote-access.md).
# An identity header from any other peer counts for nothing. Kura and Konbini refuse to start in tailscale mode without it.
#KURA_TRUSTED_PROXIES=172.18.0.1/32
#NIWA_TRUSTED_PROXIES=172.18.0.1/32
#KONBINI_TRUSTED_PROXIES=172.18.0.1/32

# Identity (optional, off by default): people, agents, sign-in without Tailscale, Shiori devices (docs/identity.md).
# `python3 -m vaultkit.identity --file /srv/machiya/identity/identity.toml setup ...` writes the file and prints these.
# The directory is mounted read-only at the same path; the file must be in it. With the file, *_USERS is unused.
#MACHIYA_IDENTITY_DIR=/srv/machiya/identity
#MACHIYA_IDENTITY_FILE=/srv/machiya/identity/identity.toml
# Built-in sign-in (a person's name and password from the file); the *_PUBLIC_URL above are the origins it accepts.
#KURA_SIGNIN=1
#NIWA_SIGNIN=1
#KONBINI_SIGNIN=1
# Behind your own auth proxy: *_AUTH=header and its login header. With the identity file, header and tailscale modes
# need *_BIND_BEHIND_PROXY=1 here (the rooms listen on all addresses inside their containers; the ports above bind
# 127.0.0.1, so the proxy on this host is the only way in).
#KURA_AUTH_HEADER=Remote-User
#NIWA_AUTH_HEADER=Remote-User
#KONBINI_AUTH_HEADER=Remote-User
#KURA_BIND_BEHIND_PROXY=1
#NIWA_BIND_BEHIND_PROXY=1
#KONBINI_BIND_BEHIND_PROXY=1

# Public URLs (what browsers use; also the sister links between services).
KURA_PUBLIC_URL=http://localhost:8083
NIWA_PUBLIC_URL=http://localhost:8082
KONBINI_PUBLIC_URL=http://localhost:8081
HISTER_PUBLIC_URL=http://localhost:4433
SEARXNG_PUBLIC_URL=http://localhost:8888
# The Rooms switcher in every app's header (the same value everywhere).
MACHIYA_ROOMS=konbini=http://localhost:8081,niwa=http://localhost:8082,kura=http://localhost:8083,hister=http://localhost:4433,searxng=http://localhost:8888
# Host ports, if a default is taken (127.0.0.1 only): HISTER_PORT=4433 SEARXNG_PORT=8888 KURA_PORT=8083 NIWA_PORT=8082
# NIWA_GEMINI_PORT=1965 NIWA_GOPHER_PORT=7070 KONBINI_PORT=8081 SMALLWEB_PORT=8090 MCP_PORT=8091 (then change the URLs above to match).
# The name in Niwa's gemini certificate and gopher menus.
NIWA_HOST=localhost
# Where this stack's source is published (adds a "Source code" link; the AGPL asks for it when others use your copy).
#MACHIYA_SOURCE_URL=https://github.com/machiya-kobo/machiya

# Engines.
SEARXNG_SECRET=            # required: generate one with `openssl rand -hex 32`
KURA_HISTER_URL=http://hister:4433     # push the notes into Hister (label vault); empty = off
KONBINI_HISTER_URL=

# Code (profile `code`): your Forgejo and GitHub repos, issues, pull requests and releases in Hister, for Shiori's Code view.
# Tokens are read-only and live in files under CODE_IMPORT_SECRETS_DIR (mounted at /secrets), never here.
# Settings and token scopes: stack/code-import/README.md.
#CODE_IMPORT_FORGEJO_URL=https://forgejo.example.com
#CODE_IMPORT_FORGEJO_OWNERS=you
#CODE_IMPORT_FORGEJO_TOKEN_FILE=/secrets/forgejo-token
#CODE_IMPORT_GITHUB_TOKEN_FILES=you=/secrets/github-you-token
#CODE_IMPORT_EXCLUDE=notes,password-store
#CODE_IMPORT_SECRETS_DIR=./secrets
