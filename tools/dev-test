"""dev-test - run the dev stack (compose/dev) and its checks on another machine, such as a clean test VM: the same
stack, the same synthetic seed, the same checks as on the dev host.

    tools/dev-test HOST [--native] [--packages] [--hister-bin FILE | --hister-via HOST2] [--siblings DIR] [--dir DIR]
                   [--keep] [--dry-run]

It copies this working tree and the kura, niwa and konbini checkouts (their tracked and untracked, not ignored, files:
what you are testing, committed or not) to HOST:DIR (default /var/tmp/machiya-dev-test, disk-backed) over ssh, then
runs there, in one shell:

    compose/dev/dev --data DIR/data init [--native] && compose/dev/dev up && compose/dev/dev check

and always `compose/dev/dev down` afterwards (unless --keep). Each run starts from a fresh DIR/data. The exit code is the remote checks' (or 1 when a step
before them fails).

  --packages     first install what the stack needs with the host's package manager (sudo or doas, no password):
                 Debian/Ubuntu: Docker from Debian's packages (the stack runs in containers);
                 FreeBSD, OpenBSD, NetBSD (always --native): Python, PyYAML, git and curl from packages, as in
                 docs/install/bsd.md, and a venv DIR/venv (--system-site-packages) with pip's markdown>=3.11, since
                 every BSD's package is older and OpenBSD's pip refuses the system Python (PEP 668); the run puts
                 DIR/venv/bin first on PATH whenever it exists. Haiku (--native): python3.14 + pip's markdown and
                 pyyaml (docs/dev-stack.md).
  --native       no containers: every service as a process (the BSDs and Haiku have no Docker). Hister is a Go binary
                 with cgo: pass one built for that OS with --hister-bin (it is copied to DIR/hister). SearXNG is left out.
  --hister-bin   a hister binary for the remote OS (--native).
  --hister-via   HOST2[:DATA] (--native) for an OS with no Hister (Haiku): use the Hister of a dev stack already running
                 on HOST2 (e.g. `tools/dev-test HOST2 --keep`; DATA defaults to DIR/data there). Its dummy owner's
                 secrets are copied over, and two ssh tunnels from here join them: HOST2's 127.0.0.1:19224 to this
                 machine's 127.0.0.1:19324, and that to HOST's 127.0.0.1:19224. Both stacks must use the same public
                 base (the default https://localhost) for Hister's documents to line up.

The checks are the HTTP ones (no browser on a test VM). Nothing secret travels: the remote init makes its own dummy
secrets. Standard library only; needs ssh and tar here.
"""
import argparse
import io
import os
import re
import shlex
import subprocess
import sys
import tarfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)

# The BSDs' venv (VENV is DIR/venv): it keeps the packages' PyYAML and adds markdown>=3.11, as docs/install/bsd.md §2.
BSD_VENV = " && python3 -m venv --system-site-packages VENV && VENV/bin/pip install -q 'markdown>=3.11'"
PACKAGES = {
    # os-release ID / uname -s -> the commands (run with sh -e on the host)
    "debian": "sudo apt-get update -q && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q git curl openssl "
              "python3 python3-yaml docker.io docker-compose && sudo usermod -aG docker \"$USER\"",
    "FreeBSD": "sudo pkg install -y python312 py312-sqlite3 py312-pyyaml git-lite curl && "
               "sudo ln -sf /usr/local/bin/python3.12 /usr/local/bin/python3" + BSD_VENV,
    "OpenBSD": "doas pkg_add python%3 py3-yaml git curl" + BSD_VENV,
    "NetBSD": "sudo env PKG_PATH=\"https://cdn.NetBSD.org/pub/pkgsrc/packages/NetBSD/$(uname -p)/"
              "$(uname -r | cut -d_ -f1)/All\" pkg_add python313 py313-yaml git-base curl && "
              "sudo ln -sf /usr/pkg/bin/python3.13 /usr/pkg/bin/python3" + BSD_VENV,
    "Haiku": "pkgman install -y python3.14 git openssl3 && python3 -m ensurepip --altinstall && "
             "python3 -m pip install 'markdown>=3.11' pyyaml tzdata",   # Haiku has no tz database: Niwa/Konbini need tzdata
}


def files(repo):
    out = subprocess.run(["git", "-C", repo, "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
                         capture_output=True, check=True).stdout.split(b"\0")
    return [f.decode() for f in out if f and os.path.isfile(os.path.join(repo, f.decode()))]


def bundle(repos, hister_bin):
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
        for name, path in repos.items():
            for f in files(path):
                tar.add(os.path.join(path, f), arcname="%s/%s" % (name, f), recursive=False)
        if hister_bin:
            tar.add(hister_bin, arcname="hister")
    return buf.getvalue()


def ssh(host, script, stdin=None):
    return subprocess.run(["ssh", "-o", "BatchMode=yes", host, "sh -c " + shlex.quote(script)], input=stdin)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("host")
    ap.add_argument("--native", action="store_true")
    ap.add_argument("--packages", action="store_true")
    ap.add_argument("--hister-bin")
    ap.add_argument("--hister-via")
    ap.add_argument("--siblings", default=os.path.dirname(ROOT))
    ap.add_argument("--dir", default="/var/tmp/machiya-dev-test")
    ap.add_argument("--keep", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()
    repos = {"machiya": ROOT}
    for r in ("kura", "niwa", "konbini"):
        repos[r] = os.path.join(a.siblings, r)
        if not os.path.isdir(os.path.join(repos[r], ".git")):
            sys.exit("dev-test: no %s checkout in %s (--siblings)" % (r, a.siblings))
    d = a.dir.rstrip("/")
    # it goes unquoted into remote shell lines, `rm -rf` among them (sweep MACH-M-13): a plain absolute path, two levels
    # deep at least, or nothing
    if not re.fullmatch(r"/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)+", d) or "/../" in d + "/" or "/./" in d + "/":
        sys.exit("dev-test: --dir must be a plain absolute path like /var/tmp/machiya-dev-test, not %r" % a.dir)
    dev = "%s/machiya/compose/dev/dev --data %s/data" % (d, d)
    init = dev + " init" + (" --native" if a.native else "")
    if a.hister_via:
        if not a.native:
            sys.exit("dev-test: --hister-via is for --native")
        init += " --remote-hister %s/hister-secrets" % d
    env = ("HISTER_BIN=%s/hister " % d) if a.hister_bin else ""
    steps = []
    if a.packages:
        steps.append('os=$(uname -s); [ "$os" = Linux ] && os=$(. /etc/os-release; echo "${ID_LIKE:-$ID}" | '
                     'cut -d" " -f1)\ncase "$os" in\n%s\n*) echo "dev-test: no package recipe for $os" >&2; exit 1;;\n'
                     'esac' % "\n".join("%s) %s ;;" % (k, v.replace("VENV", d + "/venv")) for k, v in PACKAGES.items()))
    # the BSDs' venv (--packages made it, now or on an earlier run) comes first: the native services run `python3`
    path = "if [ -x %s/venv/bin/python3 ]; then PATH=%s/venv/bin:$PATH; export PATH; fi; " % (d, d)
    run = "set -e; %s%s%s; %s%s up; %s check" % (path, env, init, env, dev, dev)
    wrap = run if a.native else "if id -nG | grep -qw docker || ! command -v docker >/dev/null; then sh -c %s; " \
                                "else sg docker -c %s; fi" % (shlex.quote(run), shlex.quote(run))
    down = "%s down >/dev/null 2>&1 || true" % dev
    if not a.keep:
        wrap = "%s; rc=$?; %s; exit $rc" % (wrap, down)
    print("dev-test: %s -> %s:%s (%s)" % (", ".join(repos), a.host, d, "native" if a.native else "containers"))
    for s in steps + [wrap]:
        print("  $ " + s.replace("\n", "\n    "))
    if a.dry_run:
        return 0
    data = bundle(repos, a.hister_bin)
    print("dev-test: copying %.1f MB" % (len(data) / 1e6), flush=True)
    r = ssh(a.host, "rm -rf %s/machiya %s/kura %s/niwa %s/konbini %s/data && mkdir -p %s && tar -xzf - -C %s%s" % (
        d, d, d, d, d, d, d, " && chmod +x %s/hister" % d if a.hister_bin else ""), stdin=data)
    if r.returncode:
        print("dev-test: copy failed")
        return 1
    if a.packages and ssh(a.host, "set -e\n" + steps[0]).returncode:
        print("dev-test: the package step failed")
        return 1
    tunnels = []
    if a.hister_via:
        via, _, via_data = a.hister_via.partition(":")
        via_data = via_data or d + "/data"
        names = "owner-password owner-token oidc-client-secret hister.env"
        secrets = subprocess.run(["ssh", "-o", "BatchMode=yes", via, "tar -C %s/secrets -cf - %s" % (
            shlex.quote(via_data), names)], capture_output=True).stdout
        if not secrets or ssh(a.host, "umask 077; rm -rf %s/hister-secrets && mkdir -p %s/hister-secrets && "
                                      "tar -xf - -C %s/hister-secrets" % (d, d, d), stdin=secrets).returncode:
            print("dev-test: couldn't copy the Hister host's secrets (is a dev stack running on %s?)" % via)
            return 1
        for args in (["-L", "19324:127.0.0.1:19224", via], ["-R", "19224:127.0.0.1:19324", a.host]):
            tunnels.append(subprocess.Popen(["ssh", "-N", "-o", "BatchMode=yes", "-o", "ExitOnForwardFailure=yes",
                                             "-o", "ServerAliveInterval=15"] + args))
        time.sleep(4)
        if any(t.poll() is not None for t in tunnels):
            print("dev-test: a tunnel failed to start")
            for t in tunnels:
                t.terminate()
            return 1
    try:
        rc = ssh(a.host, wrap).returncode
    finally:
        for t in tunnels:
            t.terminate()
    print("dev-test: %s on %s" % ("PASS" if rc == 0 else "FAIL (exit %d)" % rc, a.host))
    return rc


if __name__ == "__main__":
    sys.exit(main())
