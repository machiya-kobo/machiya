#!/bin/sh
# Make the sample vault a git repository, for the Quickstarts and the screenshots.
#
#   tools/demo-vault <dir>            copies sample-vault/ into <dir> as a working repository (branch main, one commit)
#   tools/demo-vault <dir> --bare     also makes <dir>.git, a bare clone: use file://<abs path>/<dir>.git as VAULT_REPO_URL
#
# <dir> must not exist. The commit is made by "Machiya Demo" so nothing here needs your git identity.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
dir=${1:?usage: tools/demo-vault <dir> [--bare]}
[ -e "$dir" ] && { echo "demo-vault: $dir exists" >&2; exit 1; }
mkdir -p "$dir"
cp -R "$here/sample-vault/." "$dir/"
rm -f "$dir/README.md"
git -C "$dir" init -q -b main
git -C "$dir" add -A
git -C "$dir" -c user.name="Machiya Demo" -c user.email="demo@example.invalid" -c commit.gpgsign=false commit -q -m "sample vault"
if [ "${2:-}" = "--bare" ]; then
    git clone -q --bare "$dir" "$dir.git"
    echo "bare repository: $(cd "$dir.git" && pwd)"
fi
echo "vault: $(cd "$dir" && pwd)  (folder personal/, so VAULT_SUBDIR=personal)"
